{
    "name": "sena/simple-stock-flow-api",
    "description": "Simple Stock Flow - backend (Laravel) del reto SDD ADSO 3413974",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "brick/math": "^0.12 || ^0.13 || ^0.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
